{
  "name": "acm-trainer",
  "version": "1.0.16",
  "private": true,
  "author": "DB_SLSQ",
  "type": "module",
  "main": "electron/main.js",
  "description": "单人本地使用的 ACM 训练网站：抓取 Codeforces 过题与 rating，给出目标 rating 训练计划与推荐题目",
  "scripts": {
    "start": "node --no-warnings server.js",
    "sync": "node --no-warnings scripts/sync-problems.js",
    "train": "node --no-warnings scripts/train-model.js",
    "desktop": "electron .",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.dbslsq.acmtracker",
    "productName": "ACM Trainer",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "lib/**",
      "public/**",
      "scripts/**",
      "build/icon.png",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ACM 训练台",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "DB_SLSQ"
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
